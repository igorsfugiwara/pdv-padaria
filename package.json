{
  "name": "pdv-padaria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:celular": "HTTPS=1 vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "seed:firestore": "tsx --tsconfig tsconfig.app.json scripts/seed-firestore.ts",
    "deploy:firebase": "firebase deploy --only firestore:rules,auth",
    "check:rules": "node scripts/check-rules.mjs",
    "test": "vitest run",
    "reset:demo": "tsx --tsconfig tsconfig.app.json scripts/reset-demo.ts"
  },
  "dependencies": {
    "barcode-detector": "^3.0.0",
    "firebase": "^11.10.0",
    "jose": "^5.10.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "sass": "^1.75.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0"
  }
}
